{
  "name": "dsh-gps-reader",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: read GPX, TCX and FIT activity files directly (activity_read tool)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gpx",
    "tcx",
    "fit",
    "gps",
    "activity"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
